{
  "name": "hypno-db",
  "type": "module",
  "version": "0.2.1",
  "scripts": {
    "data:validate": "node scripts/validate-data.mjs",
    "data:build": "npm run data:validate && node scripts/build-data.mjs",
    "dev": "npm run data:build && astro dev --background",
    "start": "npm run data:build && astro dev --background",
    "build": "npm run data:build && astro build",
    "preview": "npm run data:build && astro preview",
    "deploy": "./scripts/deploy.sh",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.2",
    "astro": "^7.2.10",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
