---
// src/pages/tags.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import tracksData from '../../public/data/tracks.json';

const triggerCounts: Record<string, number> = {};
tracksData.forEach(track => {
  track.triggers?.forEach(trigger => {
    triggerCounts[trigger] = (triggerCounts[trigger] || 0) + 1;
  });
});

const sortedTriggers = Object.entries(triggerCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="All Triggers">
  <main class="container" style="padding: 2.5rem 1.5rem;">
    <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem;">Audio Triggers</h1>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">Browse master audio files filtered by style, instrument, and genre classification.</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
      {sortedTriggers.map(([trigger, count]) => (
        <a 
          href={`/trigger/${trigger}`} 
          style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.25rem; text-decoration: none; color: inherit; display: flex; justify-content: space-between; align-items: center; transition: var(--transition-base);"
          class="tag-card"
        >
          <div>
            <div style="font-weight: 700; font-size: 1.1rem; color: var(--accent-cyan);">#{trigger}</div>
            <div style="font-size: 0.8rem; color: var(--text-dim);">{count} audio recording{count > 1 ? 's' : ''}</div>
          </div>
          <span>→</span>
        </a>
      ))}
    </div>
  </main>

  <style>
    .tag-card:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }
  </style>
</BaseLayout>