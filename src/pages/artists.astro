---
// src/pages/artists.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import artistData from '../../public/data/artist.json';
import tracksData from '../../public/data/tracks.json';
import { normalizeArtists } from '../utils/audio';

const artistList = normalizeArtists(artistData).map(art => {
  const tracks = tracksData.filter(t => t.artist === art.name);
  return { ...art, trackCount: tracks.length };
});
---

<BaseLayout title="All Artists">
  <main class="container" style="padding: 2.5rem 1.5rem;">
    <h1 style="font-size: 2rem; margin-bottom: 0.5rem;">Master Artists</h1>
    <p style="color: var(--text-muted); margin-bottom: 2rem;">Explore verified studio sound designers and synth architects.</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
      {artistList.map(artist => (
        <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-lg); overflow: hidden;">
          <div style="height: 120px; position: relative;">
            <img src={artist.banner} alt={artist.name} style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 1.5rem; position: relative;">
            <img src={artist.avatar} alt={artist.name} style="width: 70px; height: 70px; border-radius: 50%; border: 3px solid var(--bg-surface); margin-top: -50px; margin-bottom: 0.75rem; object-fit: cover;" />
            <h2 style="font-size: 1.3rem;">{artist.name}</h2>
            <div style="color: var(--accent-purple); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem;">{artist.genre}</div>
            <p style="color: var(--text-muted); font-size: 0.85rem; line-height: 1.5; margin-bottom: 1.25rem;">{artist.bio}</p>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.8rem; color: var(--text-dim);">{artist.trackCount} Master Files</span>
              <a href={`/artist/${artist.slug}`} class="btn btn-primary">View Artist Catalog →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>
</BaseLayout>