    const closeModalBtn = document.getElementById('close-modal-btn');
    const modalArtworkImg = document.getElementById('modal-artwork-img');
    const modalTitle = document.getElementById('modal-title');
    const modalTrackTitleSm = document.getElementById('modal-track-title');
    const modalArtist = document.getElementById('modal-artist');
    const modalDescription = document.getElementById('modal-description');
    const modalPlayBtn = document.getElementById('modal-play-btn');
    const modalCopyIdBtn = document.getElementById('modal-copy-id-btn');
    const modalShareBtn = document.getElementById('modal-share-btn');

    const specId = document.getElementById('spec-id');
    const specRelease = document.getElementById('spec-release');
    const specAudience = document.getElementById('spec-audience');
    const specDuration = document.getElementById('spec-duration');
    const specSize = document.getElementById('spec-size');
    const specFormat = document.getElementById('spec-format');
    const specBitrate = document.getElementById('spec-bitrate');
    const specBpm = document.getElementById('spec-bpm');
    const specKey = document.getElementById('spec-key');

    // Player DOM
    const audioEl = document.getElementById('global-audio-element');
    const playerBar = document.getElementById('audio-player-bar');
    const playerImg = document.getElementById('player-img');
    const playerTitle = document.getElementById('player-title');
    const playerArtist = document.getElementById('player-artist');
    const playerFormat = document.getElementById('player-format');
    const playerPlayBtn = document.getElementById('player-play-btn');
    const playerPlayIcon = document.getElementById('player-play-icon');
    const playerPauseIcon = document.getElementById('player-pause-icon');
    const playerPrevBtn = document.getElementById('player-prev-btn');
    const playerNextBtn = document.getElementById('player-next-btn');
    const playerCurrentTime = document.getElementById('player-current-time');
    const playerDuration = document.getElementById('player-duration');
    const playerScrubBar = document.getElementById('player-scrub-bar');
    const playerProgress = document.getElementById('player-progress');

    // Initialize Page
    async function init() {
      try {
        const [artistRes, tracksRes] = await Promise.all([
          fetch('./data/artist.json').then(res => res.json()),
          fetch('./data/tracks.json').then(res => res.json())
        ]);

        currentArtist = artistRes;
        allTracks = tracksRes;

        renderArtistInfo();
        renderTagFilters();
        applyFiltersAndRender();
        setupEventListeners();

      } catch (err) {
        console.error('Failed to load JSON data:', err);
        trackGrid.innerHTML = `
          <div class="empty-state">
            <div class="empty-icon">⚠️</div>
            <h3>Unable to load audio database JSON</h3>
            <p>Ensure <code>public/data/tracks.json</code> exists.</p>
          </div>
        `;
      }
    }

    // Toast Alert Notification
    function showToast(message) {
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.innerHTML = `<span>✨</span> <span>${message}</span>`;
      toastContainer.appendChild(toast);
      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    // Render Artist Header & Telemetry
    function renderArtistInfo() {
      if (artistName) artistName.textContent = currentArtist.name || 'Artist Name';
      if (artistGenre) artistGenre.textContent = currentArtist.genre || '';
      if (artistBio) artistBio.textContent = currentArtist.bio || '';
      if (artistAvatar && currentArtist.avatar) artistAvatar.src = currentArtist.avatar;
      if (artistBanner && currentArtist.banner) artistBanner.src = currentArtist.banner;
      
      if (telTracks) telTracks.textContent = `${allTracks.length} Tracks`;

      let totalSec = 0;
      allTracks.forEach(t => totalSec += parseDuration(t.duration));
      const totalMin = Math.floor(totalSec / 60);
      const remSec = totalSec % 60;
      if (telDuration) telDuration.textContent = `${totalMin}m ${remSec < 10 ? '0' : ''}${remSec}s`;

      if (allTracks.length > 0) {
        const sortedDates = [...allTracks].sort((a, b) => new Date(b.releaseDate) - new Date(a.releaseDate));
        if (telLatest) telLatest.textContent = formatDate(sortedDates[0].releaseDate);
      }
    }

    function renderTagFilters() {
      const tagsSet = new Set();
      allTracks.forEach(t => (t.tags || []).forEach(tag => tagsSet.add(tag)));

      tagsContainer.innerHTML = '<span class="tag-title">Filter Tag:</span><button class="tag-btn active" data-tag="ALL">All</button>';

      Array.from(tagsSet).sort().forEach(tag => {
        const btn = document.createElement('button');
        btn.className = 'tag-btn';
        btn.dataset.tag = tag;
        btn.textContent = tag;
        tagsContainer.appendChild(btn);
      });
    }

    function formatDate(dateStr) {
      if (!dateStr) return 'Unknown';
      return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    }

    function parseDuration(durStr) {
      if (!durStr) return 0;
      const parts = durStr.split(':').map(Number);
      return parts.length === 2 ? parts[0] * 60 + parts[1] : parts[0] || 0;
    }

    // Filter & Sort
    function getFilteredTracks() {
      const query = (searchInput.value || '').toLowerCase().trim();
      const audience = audienceFilter.value;
      const sortBy = sortSelect.value;

      let filtered = allTracks.filter(track => {
        const matchesQuery = !query || 
          track.title.toLowerCase().includes(query) ||
          (track.description && track.description.toLowerCase().includes(query)) ||
          (track.artist && track.artist.toLowerCase().includes(query)) ||
          (track.format && track.format.toLowerCase().includes(query)) ||
          (track.key && track.key.toLowerCase().includes(query)) ||
          (track.tags && track.tags.some(t => t.toLowerCase().includes(query)));

        const matchesAudience = audience === 'ALL' || track.audience === audience;
        const matchesTag = activeTag === 'ALL' || (track.tags && track.tags.includes(activeTag));

        return matchesQuery && matchesAudience && matchesTag;
      });

      filtered.sort((a, b) => {
        if (sortBy === 'newest') return new Date(b.releaseDate) - new Date(a.releaseDate);
        if (sortBy === 'oldest') return new Date(a.releaseDate) - new Date(b.releaseDate);
        if (sortBy === 'title-asc') return a.title.localeCompare(b.title);
        if (sortBy === 'duration-desc') return parseDuration(b.duration) - parseDuration(a.duration);
        return 0;
      });

      return filtered;
    }

    function applyFiltersAndRender() {
      const filtered = getFilteredTracks();
      renderTrackCards(filtered);
    }

    // Render Track Cards HTML (HIGH-CRAFT PREMIUM TILE DESIGN)
    function renderTrackCards(tracks) {
      countBadge.textContent = `${tracks.length} Track${tracks.length === 1 ? '' : 's'}`;

      if (tracks.length === 0) {
        trackGrid.style.display = 'none';
        emptyState.style.display = 'block';
        return;
      }

      emptyState.style.display = 'none';
      trackGrid.style.display = 'grid';

      trackGrid.innerHTML = tracks.map(track => {
        const globalIdx = allTracks.findIndex(t => t.id === track.id);
        const isCurrentPlaying = (currentTrackIndex === globalIdx) && isPlaying;

        return `
          <article class="track-card ${isCurrentPlaying ? 'is-active-playing' : ''}" data-id="${track.id}" data-index="${globalIdx}">
            <div class="card-artwork-wrapper">
              <span class="card-id-code">#${track.id}</span>
              <span class="audience-pill audience-${track.audience}">${track.audience}</span>
              <img src="${track.artwork}" alt="${track.title} Cover Artwork" class="artwork-img" loading="lazy" />
              <div class="artwork-overlay"></div>

              <button class="play-overlay-btn ${isCurrentPlaying ? 'is-playing' : ''}" data-action="toggle-play" data-id="${track.id}" aria-label="Play ${track.title}">
                <div class="play-circle">
                  ${isCurrentPlaying ? `
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                      <rect x="6" y="4" width="4" height="16"></rect>
                      <rect x="14" y="4" width="4" height="16"></rect>
                    </svg>
                  ` : `
                    <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  `}
                </div>
              </button>
            </div>

            <div class="card-info-content">
              <h3 class="track-title">${escapeHtml(track.title)}</h3>
              <div class="track-artist">By ${escapeHtml(track.artist)}</div>
              <p class="track-description-preview">${escapeHtml(track.description || '')}</p>

              <!-- Waveform Spectrum Bar -->
              <div class="waveform-mini" title="Audio Amplitude Preview">
                <div class="wave-bar" style="--bar-h: 40%;"></div>
                <div class="wave-bar" style="--bar-h: 70%;"></div>
                <div class="wave-bar" style="--bar-h: 100%;"></div>
                <div class="wave-bar" style="--bar-h: 50%;"></div>
                <div class="wave-bar" style="--bar-h: 85%;"></div>
                <div class="wave-bar" style="--bar-h: 30%;"></div>
                <div class="wave-bar" style="--bar-h: 90%;"></div>
                <div class="wave-bar" style="--bar-h: 60%;"></div>
                <div class="wave-bar" style="--bar-h: 100%;"></div>
                <div class="wave-bar" style="--bar-h: 45%;"></div>
                <div class="wave-bar" style="--bar-h: 75%;"></div>
                <div class="wave-bar" style="--bar-h: 35%;"></div>
              </div>

              <!-- Micro Technical Spec Badges -->
              <div class="spec-badges-row">
                <span class="spec-badge" title="Duration">
                  <svg class="spec-icon" width="14" height="14" style="width:14px;height:14px;min-width:14px;min-height:14px;flex-shrink:0;display:inline-block;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  ${track.duration}
                </span>
                ${track.bpm ? `
                  <span class="spec-badge" title="Tempo">
                    <svg class="spec-icon" width="14" height="14" style="width:14px;height:14px;min-width:14px;min-height:14px;flex-shrink:0;display:inline-block;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    ${track.bpm}
                  </span>
                ` : ''}
                ${track.format ? `
                  <span class="spec-badge" title="Format">
                    <svg class="spec-icon" width="14" height="14" style="width:14px;height:14px;min-width:14px;min-height:14px;flex-shrink:0;display:inline-block;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10v4M6 6v12M10 3v18M14 8v8M18 5v14M22 10v4"></path></svg>
                    ${track.format}
                  </span>
                ` : ''}
              </div>
            </div>

            <div class="card-footer">
              <button class="detail-link-btn" data-action="open-detail" data-id="${track.id}">
                <span>Inspect Details & Specs</span>
                <svg class="arrow-icon" width="14" height="14" style="width:14px;height:14px;min-width:14px;min-height:14px;flex-shrink:0;display:inline-block;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
          </article>
        `;
      }).join('');
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Open Detailed Information View Modal
    function openTrackDetail(trackId) {
      const track = allTracks.find(t => t.id === trackId);
      if (!track) return;

      selectedTrack = track;

      modalArtworkImg.src = track.artwork;
      modalTitle.textContent = track.title;
      if (modalTrackTitleSm) modalTrackTitleSm.textContent = track.title;
      modalArtist.textContent = `By ${track.artist}`;
      modalDescription.textContent = track.description || 'No detailed audio description provided.';

      specId.textContent = `#${track.id}`;
      specRelease.textContent = formatDate(track.releaseDate);
      specAudience.textContent = track.audience;
      specDuration.textContent = track.duration;
      specSize.textContent = track.fileSize || 'N/A';
      specFormat.textContent = track.format || 'Standard Audio';
      specBitrate.textContent = track.bitrate || '24-bit / 96 kHz';
      specBpm.textContent = track.bpm || 'Unspecified';
      specKey.textContent = track.key || 'Unspecified';

      detailModalOverlay.classList.add('active');
    }

    function closeTrackDetail() {
      detailModalOverlay.classList.remove('active');
    }

    // Playback Logic
    function playTrackIndex(idx) {
      if (idx < 0 || idx >= allTracks.length) return;

      const track = allTracks[idx];
      if (currentTrackIndex === idx) {
        if (audioEl.paused) {
          audioEl.play();
          isPlaying = true;
        } else {
          audioEl.pause();
          isPlaying = false;
        }
      } else {
        currentTrackIndex = idx;
        audioEl.src = track.audioUrl;
        audioEl.play().catch(e => console.log('Autoplay prevented:', e));
        isPlaying = true;

        playerImg.src = track.artwork;
        playerTitle.textContent = track.title;
        playerArtist.textContent = track.artist;
        playerFormat.textContent = `${track.format || 'Audio'} • ${track.bitrate || 'Lossless'}`;
        playerBar.classList.add('active');
      }

      updatePlayerState();
      applyFiltersAndRender();
    }

    function updatePlayerState() {
      if (isPlaying) {
        playerPlayIcon.style.display = 'none';
        playerPauseIcon.style.display = 'block';
      } else {
        playerPlayIcon.style.display = 'block';
        playerPauseIcon.style.display = 'none';
      }
    }

    // Event Listeners
    function setupEventListeners() {
      searchInput.addEventListener('input', applyFiltersAndRender);
      audienceFilter.addEventListener('change', applyFiltersAndRender);
      sortSelect.addEventListener('change', applyFiltersAndRender);

      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !detailModalOverlay.classList.contains('active')) {
          e.preventDefault();
          searchInput.focus();
        }
        if (e.key === 'Escape' && detailModalOverlay.classList.contains('active')) {
          closeTrackDetail();
        }
      });

      closeModalBtn.addEventListener('click', closeTrackDetail);

      detailModalOverlay.addEventListener('click', (e) => {
        if (e.target === detailModalOverlay) closeTrackDetail();
      });

      modalPlayBtn.addEventListener('click', () => {
        if (selectedTrack) {
          const idx = allTracks.findIndex(t => t.id === selectedTrack.id);
          playTrackIndex(idx);
        }
      });

      modalCopyIdBtn.addEventListener('click', () => {
        if (selectedTrack) {
          navigator.clipboard.writeText(selectedTrack.id).then(() => {
            showToast(`Copied Track ID #${selectedTrack.id}`);
          });
        }
      });

      modalShareBtn.addEventListener('click', () => {
        if (selectedTrack) {
          navigator.clipboard.writeText(selectedTrack.audioUrl).then(() => {
            showToast(`Copied Audio URL to clipboard!`);
          });
        }
      });

      tagsContainer.addEventListener('click', (e) => {
        if (e.target.classList.contains('tag-btn')) {
          document.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('active'));
          e.target.classList.add('active');
          activeTag = e.target.dataset.tag;
          applyFiltersAndRender();
        }
      });

      trackGrid.addEventListener('click', (e) => {
        const playBtn = e.target.closest('[data-action="toggle-play"]');
        if (playBtn) {
          e.stopPropagation();
          const card = playBtn.closest('.track-card');
          const index = parseInt(card.dataset.index, 10);
          playTrackIndex(index);
          return;
        }

        const card = e.target.closest('.track-card');
        if (card) {
          const id = card.dataset.id;
          openTrackDetail(id);
        }
      });

      playerPlayBtn.addEventListener('click', () => {
        if (currentTrackIndex >= 0) playTrackIndex(currentTrackIndex);
        else if (allTracks.length > 0) playTrackIndex(0);
      });

      playerPrevBtn.addEventListener('click', () => {
        if (currentTrackIndex > 0) playTrackIndex(currentTrackIndex - 1);
        else if (allTracks.length > 0) playTrackIndex(allTracks.length - 1);
      });

      playerNextBtn.addEventListener('click', () => {
        if (currentTrackIndex >= 0 && currentTrackIndex < allTracks.length - 1) {
          playTrackIndex(currentTrackIndex + 1);
        } else if (allTracks.length > 0) {
          playTrackIndex(0);
        }
      });

      audioEl.addEventListener('timeupdate', () => {
        if (audioEl.duration) {
          const pct = (audioEl.currentTime / audioEl.duration) * 100;
          playerProgress.style.width = `${pct}%`;
          playerCurrentTime.textContent = formatTime(audioEl.currentTime);
          playerDuration.textContent = formatTime(audioEl.duration);
        }
      });

      audioEl.addEventListener('ended', () => {
        if (currentTrackIndex < allTracks.length - 1) {
          playTrackIndex(currentTrackIndex + 1);
        } else {
          isPlaying = false;
          updatePlayerState();
          applyFiltersAndRender();
        }
      });

      playerScrubBar.addEventListener('click', (e) => {
        if (!audioEl.duration) return;
        const rect = playerScrubBar.getBoundingClientRect();
        const pos = (e.clientX - rect.left) / rect.width;
        audioEl.currentTime = pos * audioEl.duration;
      });
    }

    function formatTime(seconds) {
      if (isNaN(seconds)) return '0:00';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    init();
  </script>
</body>
</html>
