---
// src/pages/index.astro
import artistData from '../../public/data/artist.json';
import tracksData from '../../public/data/tracks.json';

// Pre-compute server-side telemetry metrics for instant zero-JS render
const totalTracksCount = tracksData.length;
const totalDurationSec = tracksData.reduce((acc, t) => {
  const parts = (t.duration || '0:0').split(':').map(Number);
  return acc + (parts.length === 2 ? parts[0] * 60 + parts[1] : parts[0] || 0);
}, 0);

const totalMinutes = Math.floor(totalDurationSec / 60);
const remainingSeconds = totalDurationSec % 60;
const formattedTotalDuration = `${totalMinutes}m ${remainingSeconds < 10 ? '0' : ''}${remainingSeconds}s`;

const sortedByDate = [...tracksData].sort((a, b) => new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime());
const latestRelease = sortedByDate[0]?.releaseDate 
  ? new Date(sortedByDate[0].releaseDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : 'N/A';

const uniqueTags = Array.from(new Set(tracksData.flatMap(t => t.tags || []))).sort();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{artistData.name} — Studio Audio Catalog & Maintenance</title>
  <meta name="description" content={`${artistData.name} Master Audio Database. ${artistData.bio}`} />
  <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
  
  <style is:global>
    :root {
      --bg-dark: #05070a;
      --bg-surface: #0b0f17;
      --bg-card: #111723;
      --bg-card-hover: #161e2e;
      --border-color: rgba(255, 255, 255, 0.08);
      --border-glow: rgba(99, 102, 241, 0.35);
      
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --primary-glow: rgba(99, 102, 241, 0.25);
      
      --accent-cyan: #06b6d4;
      --accent-purple: #a855f7;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;

      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 16px;
      
      --transition-base: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(99, 102, 241, 0.12) 0%, transparent 55%),
        radial-gradient(circle at 90% 25%, rgba(168, 85, 247, 0.07) 0%, transparent 40%),
        linear-gradient(to bottom, rgba(5, 7, 10, 0.85), #05070a);
      background-attachment: fixed;
      color: var(--text-main);
      line-height: 1.5;
      padding-bottom: 140px;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Header */
    header {
      border-bottom: 1px solid var(--border-color);
      background: rgba(5, 7, 10, 0.85);
      backdrop-filter: blur(16px);
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .nav-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 70px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      text-decoration: none;
      color: var(--text-main);
      font-weight: 800;
      font-size: 1.3rem;
      letter-spacing: -0.02em;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--primary), var(--accent-purple));
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      box-shadow: 0 0 16px var(--primary-glow);
    }

    .brand-subtitle {
      font-size: 0.68rem;
      color: var(--text-dim);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      display: block;
    }

    .studio-status-badge {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.25);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent-emerald);
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: var(--accent-emerald);
      box-shadow: 0 0 8px var(--accent-emerald);
      animation: pulseDot 2s infinite;
    }

    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    /* Hero Banner */
    .hero-banner {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin: 2rem 0;
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
    }

    .banner-wrapper {
      position: relative;
      height: 180px;
      overflow: hidden;
    }

    .banner-bg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.65;
    }

    .banner-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 20%, var(--bg-surface) 100%);
    }

    .artist-profile {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding: 0 2rem 2rem 2rem;
      margin-top: -65px;
      position: relative;
      z-index: 5;
    }

    @media (min-width: 768px) {
      .artist-profile {
        flex-direction: row;
        align-items: flex-end;
      }
    }

    .artist-avatar {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      border: 4px solid var(--bg-dark);
      object-fit: cover;
      background-color: var(--bg-card);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.7);
    }

    .artist-title-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 0.35rem;
    }

    .artist-name {
      font-size: 2.1rem;
      font-weight: 800;
      letter-spacing: -0.03em;
    }

    .badge-tag {
      font-size: 0.72rem;
      font-weight: 700;
      background: rgba(6, 182, 212, 0.12);
      color: var(--accent-cyan);
      border: 1px solid rgba(6, 182, 212, 0.3);
      padding: 0.2rem 0.65rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .artist-genre {
      color: var(--accent-purple);
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 0.4rem;
    }

    .artist-bio {
      color: var(--text-muted);
      font-size: 0.92rem;
      max-width: 800px;
      margin-bottom: 1.25rem;
      line-height: 1.5;
    }

    /* Telemetry grid */
    .telemetry-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    @media (min-width: 640px) {
      .telemetry-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .telemetry-card {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.65rem 0.85rem;
      display: flex;
      flex-direction: column;
    }

    .telemetry-label {
      font-size: 0.68rem;
      color: var(--text-dim);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .telemetry-value {
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--text-main);
    }

    /* Controls Section */
    .controls-section {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      margin-bottom: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .controls-main-row {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    @media (min-width: 768px) {
      .controls-main-row {
        flex-direction: row;
      }
    }

    .search-box {
      flex: 1;
      position: relative;
    }

    .search-input {
      width: 100%;
      background-color: var(--bg-dark);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.8rem 2.8rem 0.8rem 2.6rem;
      color: var(--text-main);
      font-size: 0.92rem;
      outline: none;
      transition: var(--transition-base);
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-glow);
    }

    .search-icon {
      position: absolute;
      left: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
      pointer-events: none;
    }

    .shortcut-hint {
      position: absolute;
      right: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border-color);
      color: var(--text-dim);
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-family: monospace;
      pointer-events: none;
    }

    .filter-group {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .select-control {
      background-color: var(--bg-dark);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.8rem 1rem;
      border-radius: var(--radius-md);
      font-size: 0.88rem;
      outline: none;
      cursor: pointer;
      transition: var(--transition-base);
    }

    .select-control:focus {
      border-color: var(--primary);
    }

    /* Tag Pills */
    .tags-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border-color);
    }

    .tag-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .tag-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 0.3rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition-base);
    }

    .tag-btn:hover {
      background: rgba(255, 255, 255, 0.09);
      color: var(--text-main);
    }

    .tag-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 2px 10px var(--primary-glow);
    }

    /* Track List Header */
    .tracks-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
    }

    .tracks-title {
      font-size: 1.4rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .count-badge {
      background: rgba(99, 102, 241, 0.12);
      color: var(--primary);
      border: 1px solid rgba(99, 102, 241, 0.25);
      padding: 0.2rem 0.65rem;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 700;
    }

    /* 4-Column Track Grid */
    .track-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    @media (min-width: 640px) {
      .track-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .track-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (min-width: 1280px) {
      .track-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    /* Track Card */
    .track-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: var(--transition-base);
      cursor: pointer;
      position: relative;
    }

    .track-card:hover {
      background: var(--bg-card-hover);
      border-color: rgba(99, 102, 241, 0.4);
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
    }

    .track-card.is-active-playing {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.3);
    }

    .card-artwork-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 8px;
      overflow: hidden;
      background: #05070a;
    }

    .artwork-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .track-card:hover .artwork-img {
      transform: scale(1.03);
    }

    .card-id-code {
      position: absolute;
      top: 8px;
      left: 8px;
      z-index: 2;
      font-family: ui-monospace, monospace;
      font-size: 0.65rem;
      font-weight: 700;
      color: #fff;
      background: rgba(5, 7, 10, 0.8);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 2px 6px;
      border-radius: 4px;
    }

    .audience-pill {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 2;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .audience-General {
      background: rgba(16, 185, 129, 0.25);
      color: #6ee7b7;
      border: 1px solid rgba(16, 185, 129, 0.4);
    }

    .audience-Clean {
      background: rgba(59, 130, 246, 0.25);
      color: #93c5fd;
      border: 1px solid rgba(59, 130, 246, 0.4);
    }

    .audience-Explicit {
      background: rgba(245, 158, 11, 0.25);
      color: #fcd34d;
      border: 1px solid rgba(245, 158, 11, 0.4);
    }

    .play-overlay-btn {
      position: absolute;
      inset: 0;
      z-index: 3;
      background: rgba(5, 7, 10, 0.45);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      border: none;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .track-card:hover .play-overlay-btn,
    .play-overlay-btn.is-playing {
      opacity: 1;
    }

    .play-circle {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--primary);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.5);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .play-overlay-btn:hover .play-circle {
      transform: scale(1.08);
      background: var(--primary-hover);
    }

    .play-overlay-btn:active .play-circle {
      transform: scale(0.95);
    }

    .card-info-content {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .track-title {
      font-size: 0.98rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .track-artist {
      color: var(--accent-purple);
      font-size: 0.78rem;
      font-weight: 600;
    }

    .track-description-preview {
      color: var(--text-muted);
      font-size: 0.75rem;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Waveform indicator */
    .waveform-mini {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      height: 16px;
      margin: 4px 0 2px 0;
    }

    .wave-bar {
      flex: 1;
      height: var(--bar-h, 30%);
      background: rgba(255, 255, 255, 0.12);
      border-radius: 2px;
    }

    .track-card.is-active-playing .wave-bar {
      background: var(--accent-cyan);
      animation: waveBounce 1.2s infinite alternate ease-in-out;
    }

    @keyframes waveBounce {
      0% { height: calc(var(--bar-h, 30%) * 0.3); }
      100% { height: var(--bar-h, 30%); }
    }

    .spec-badges-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 5px;
      margin-top: 4px;
    }

    .spec-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.7rem;
      color: var(--text-muted);
      font-family: ui-monospace, monospace;
    }

    .spec-badge svg {
      width: 12px;
      height: 12px;
      flex-shrink: 0;
    }

    .card-footer {
      margin-top: auto;
      padding-top: 8px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .detail-link-btn {
      width: 100%;
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: color 0.2s;
    }

    .track-card:hover .detail-link-btn {
      color: var(--text-main);
    }

    /* Modal / Inspector View */
    .detail-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(5, 7, 10, 0.88);
      backdrop-filter: blur(16px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .detail-modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .detail-modal-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-glow);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 900px;
      max-height: 88vh;
      overflow-y: auto;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
      position: relative;
    }

    .modal-header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.1rem 1.75rem;
      border-bottom: 1px solid var(--border-color);
      background: rgba(0, 0, 0, 0.25);
      position: sticky;
      top: 0;
      z-index: 10;
      backdrop-filter: blur(10px);
    }

    .modal-breadcrumb {
      font-size: 0.82rem;
      color: var(--text-dim);
    }

    .close-modal-btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition-base);
    }

    .close-modal-btn:hover {
      background: var(--primary);
      color: #fff;
    }

    .modal-body-layout {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    @media (min-width: 768px) {
      .modal-body-layout {
        flex-direction: row;
      }
    }

    .modal-artwork-section {
      width: 250px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .modal-artwork-img {
      width: 240px;
      height: 240px;
      border-radius: var(--radius-md);
      object-fit: cover;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.7);
      border: 1px solid var(--border-color);
    }

    .modal-details-section {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .modal-track-title {
      font-size: 1.8rem;
      font-weight: 800;
      line-height: 1.2;
    }

    .modal-track-artist {
      font-size: 1rem;
      color: var(--accent-purple);
      font-weight: 700;
    }

    .modal-description {
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.6;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 0.85rem 1.1rem;
    }

    .modal-specs-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    @media (min-width: 600px) {
      .modal-specs-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    .spec-item-box {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 0.65rem 0.85rem;
      display: flex;
      flex-direction: column;
    }

    .spec-item-label {
      font-size: 0.68rem;
      color: var(--text-dim);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .spec-item-value {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-md);
      font-weight: 700;
      font-size: 0.9rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      box-shadow: 0 4px 14px var(--primary-glow);
      transition: var(--transition-base);
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-main);
      border: 1px solid var(--border-color);
      padding: 0.7rem 1.2rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      transition: var(--transition-base);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    /* Floating Studio Audio Console Bar */
    .audio-player-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(11, 15, 23, 0.96);
      backdrop-filter: blur(20px);
      border-top: 1px solid var(--border-glow);
      z-index: 50;
      padding: 0.75rem 1.5rem;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .audio-player-bar.active {
      transform: translateY(0);
    }

    .player-container {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    @media (min-width: 860px) {
      .player-container {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }

    .player-track-info {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      min-width: 240px;
    }

    .player-artwork {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-sm);
      object-fit: cover;
    }

    .player-title {
      font-weight: 800;
      font-size: 0.92rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .player-artist {
      font-size: 0.75rem;
      color: var(--accent-purple);
      font-weight: 600;
      display: block;
    }

    .player-format-badge {
      font-size: 0.65rem;
      color: var(--accent-cyan);
      font-weight: 700;
      font-family: monospace;
      display: block;
    }

    .player-center-controls {
      flex: 1;
      max-width: 620px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .player-btn-group {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .icon-btn {
      background: none;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition-base);
    }

    .icon-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-main);
    }

    .icon-btn.active {
      color: var(--accent-cyan);
      border-color: var(--accent-cyan);
    }

    .play-btn-large {
      width: 42px;
      height: 42px;
      background: var(--primary);
      color: white;
      border-radius: 50%;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 14px var(--primary-glow);
      transition: var(--transition-base);
    }

    .play-btn-large:hover {
      background: var(--primary-hover);
      transform: scale(1.05);
    }

    .scrub-timeline {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.75rem;
      font-family: monospace;
      color: var(--text-dim);
    }

    /* Accessible Range Sliders */
    .accessible-range {
      -webkit-appearance: none;
      appearance: none;
      background: rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
      height: 6px;
      outline: none;
      cursor: pointer;
      width: 100%;
      transition: background 0.15s ease;
    }

    .accessible-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent-cyan);
      cursor: pointer;
      box-shadow: 0 0 6px rgba(6, 182, 212, 0.6);
      transition: transform 0.15s ease;
    }

    .accessible-range::-webkit-slider-thumb:hover {
      transform: scale(1.25);
    }

    /* Volume and Right Utilities */
    .player-utilities {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 200px;
      justify-content: flex-end;
    }

    .volume-control-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 130px;
    }

    /* Toast */
    .toast-container {
      position: fixed;
      top: 85px;
      right: 20px;
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      pointer-events: none;
    }

    .toast {
      background: var(--bg-card);
      border: 1px solid var(--primary);
      color: var(--text-main);
      padding: 0.7rem 1.1rem;
      border-radius: var(--radius-md);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
      font-size: 0.85rem;
      font-weight: 600;
      animation: toastSlide 0.25s ease forwards;
    }

    @keyframes toastSlide {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .empty-state {
      text-align: center;
      padding: 3.5rem 1.5rem;
      background: var(--bg-surface);
      border: 1px dashed var(--border-color);
      border-radius: var(--radius-lg);
      color: var(--text-muted);
    }

    .empty-state button {
      margin-top: 1rem;
    }
  </style>
</head>

<body>
  <!-- Toast Notification Portal -->
  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <!-- Header -->
  <header>
    <div class="container nav-wrapper">
      <a href="./" class="brand" aria-label="AudioDB Homepage">
        <div class="brand-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
        </div>
        <div>
          <span>AudioDB</span>
          <span class="brand-subtitle">Studio Maintenance Console</span>
        </div>
      </a>

      <div class="studio-status-badge" role="status">
        <span class="status-dot"></span>
        <span>Studio Engine Active</span>
      </div>
    </div>
  </header>

  <main class="container">
    <!-- Artist Banner & Telemetry (Pre-rendered SSG) -->
    <section class="hero-banner" aria-labelledby="artist-name">
      <div class="banner-wrapper">
        <img id="artist-banner" src={artistData.banner} alt={`${artistData.name} Studio Banner`} class="banner-bg" />
        <div class="banner-overlay"></div>
      </div>

      <div class="artist-profile">
        <img id="artist-avatar" src={artistData.avatar} alt={`${artistData.name} Avatar`} class="artist-avatar" />

        <div style="flex: 1;">
          <div class="artist-title-row">
            <h1 id="artist-name" class="artist-name">{artistData.name}</h1>
            <span class="badge-tag">Verified Master Artist</span>
          </div>

          <p class="artist-genre">{artistData.genre}</p>
          <p class="artist-bio">{artistData.bio}</p>

          <!-- Telemetry -->
          <div class="telemetry-grid">
            <div class="telemetry-card">
              <span class="telemetry-label">Audio Files</span>
              <span id="tel-tracks" class="telemetry-value">{totalTracksCount} Tracks</span>
            </div>
            <div class="telemetry-card">
              <span class="telemetry-label">Cumulative Duration</span>
              <span id="tel-duration" class="telemetry-value">{formattedTotalDuration}</span>
            </div>
            <div class="telemetry-card">
              <span class="telemetry-label">Master Spec</span>
              <span class="telemetry-value">24-bit / 96 kHz</span>
            </div>
            <div class="telemetry-card">
              <span class="telemetry-label">Latest Master</span>
              <span id="tel-latest" class="telemetry-value">{latestRelease}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Search & Filter Controls -->
    <section class="controls-section" aria-label="Search and filter tracks">
      <div class="controls-main-row">
        <div class="search-box">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="search-input" 
            class="search-input" 
            placeholder="Search audio files by title, format, BPM, key, tags..." 
            aria-label="Search audio files"
          />
          <span class="shortcut-hint" aria-hidden="true">/</span>
        </div>

        <div class="filter-group">
          <select id="audience-filter" class="select-control" aria-label="Filter by Audience">
            <option value="ALL">All Audiences</option>
            <option value="General">General</option>
            <option value="Clean">Clean</option>
            <option value="Explicit">Explicit</option>
          </select>

          <select id="sort-select" class="select-control" aria-label="Sort audio files">
            <option value="newest">Release: Newest First</option>
            <option value="oldest">Release: Oldest First</option>
            <option value="title-asc">Title: A to Z</option>
            <option value="duration-desc">Duration: Longest First</option>
          </select>
        </div>
      </div>

      <!-- Tag Filter Pills -->
      <div id="tags-container" class="tags-row" role="group" aria-label="Filter by Tag">
        <span class="tag-title">Tags:</span>
        <button class="tag-btn active" data-tag="ALL">All</button>
        {uniqueTags.map(tag => (
          <button class="tag-btn" data-tag={tag}>{tag}</button>
        ))}
      </div>
    </section>

    <!-- Audio Track List Section -->
    <section aria-labelledby="section-heading-tracks">
      <div class="tracks-header">
        <h2 id="section-heading-tracks" class="tracks-title">Master Audio Catalog</h2>
        <span id="count-badge" class="count-badge">{totalTracksCount} Tracks</span>
      </div>

      <!-- Initial Pre-Rendered Grid for Immediate Paint -->
      <div id="track-grid" class="track-grid">
        {tracksData.map((track, idx) => (
          <article class="track-card" data-id={track.id} data-index={idx} tabindex="0" role="region" aria-label={`Track card for ${track.title}`}>
            <div class="card-artwork-wrapper">
              <span class="card-id-code">#{track.id}</span>
              <span class={`audience-pill audience-${track.audience}`}>{track.audience}</span>
              <img src={track.artwork} alt={`${track.title} artwork`} class="artwork-img" loading="lazy" />

              <button class="play-overlay-btn" data-action="toggle-play" data-id={track.id} aria-label={`Play ${track.title}`}>
                <div class="play-circle">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </div>
              </button>
            </div>

            <div class="card-info-content">
              <h3 class="track-title">{track.title}</h3>
              <div class="track-artist">By {track.artist}</div>
              <p class="track-description-preview">{track.description}</p>

              <!-- Waveform visualization bars -->
              <div class="waveform-mini" aria-hidden="true">
                <div class="wave-bar" style="--bar-h: 40%;"></div>
                <div class="wave-bar" style="--bar-h: 70%;"></div>
                <div class="wave-bar" style="--bar-h: 100%;"></div>
                <div class="wave-bar" style="--bar-h: 50%;"></div>
                <div class="wave-bar" style="--bar-h: 85%;"></div>
                <div class="wave-bar" style="--bar-h: 30%;"></div>
                <div class="wave-bar" style="--bar-h: 90%;"></div>
                <div class="wave-bar" style="--bar-h: 60%;"></div>
              </div>

              <div class="spec-badges-row">
                <span class="spec-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {track.duration}
                </span>
                {track.bpm && (
                  <span class="spec-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    {track.bpm}
                  </span>
                )}
                {track.format && (
                  <span class="spec-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 10v4M6 6v12M10 3v18M14 8v8M18 5v14M22 10v4"></path></svg>
                    {track.format}
                  </span>
                )}
              </div>
            </div>

            <div class="card-footer">
              <button class="detail-link-btn" data-action="open-detail" data-id={track.id}>
                <span>Inspect Technical Specs</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
          </article>
        ))}
      </div>

      <!-- Empty State -->
      <div id="empty-state" class="empty-state" style="display: none;">
        <h3>No matching audio records found</h3>
        <p>Try clearing your search query or tag filters.</p>
        <button id="reset-filters-btn" class="btn-secondary">Reset All Filters</button>
      </div>
    </section>
  </main>

  <!-- Track Inspector Modal Dialog -->
  <div id="detail-modal-overlay" class="detail-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-track-title">
    <div class="detail-modal-card">
      <div class="modal-header-bar">
        <div class="modal-breadcrumb">
          <span>AudioDB Catalog</span> / <strong id="modal-track-title">Track Details</strong>
        </div>
        <button id="close-modal-btn" class="close-modal-btn" aria-label="Close inspector">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="modal-body-layout">
        <div class="modal-artwork-section">
          <img id="modal-artwork-img" src={tracksData[0]?.artwork} alt="Cover artwork" class="modal-artwork-img" />
          <button id="modal-play-btn" class="btn-primary" style="width: 100%; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Play Track</span>
          </button>
        </div>

        <div class="modal-details-section">
          <div>
            <h2 id="modal-title" class="modal-track-title">Title</h2>
            <div id="modal-artist" class="modal-track-artist">Artist</div>
          </div>

          <p id="modal-description" class="modal-description"></p>

          <div class="modal-specs-grid">
            <div class="spec-item-box"><span class="spec-item-label">Track ID</span><span id="spec-id" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Release</span><span id="spec-release" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Audience</span><span id="spec-audience" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Duration</span><span id="spec-duration" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">File Size</span><span id="spec-size" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Format</span><span id="spec-format" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Sample Rate</span><span id="spec-bitrate" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Tempo</span><span id="spec-bpm" class="spec-item-value">-</span></div>
            <div class="spec-item-box"><span class="spec-item-label">Key</span><span id="spec-key" class="spec-item-value">-</span></div>
          </div>

          <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button id="modal-copy-id-btn" class="btn-secondary">📋 Copy ID</button>
            <button id="modal-share-btn" class="btn-secondary">🔗 Copy Audio Link</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Persistent Global Audio Console Bar -->
  <aside id="audio-player-bar" class="audio-player-bar" aria-label="Audio Playback Console">
    <div class="player-container">
      <div class="player-track-info">
        <img id="player-img" src={tracksData[0]?.artwork} alt="Now playing artwork" class="player-artwork" />
        <div>
          <span id="player-title" class="player-title">Select a track</span>
          <span id="player-artist" class="player-artist">{artistData.name}</span>
          <span id="player-format" class="player-format-badge">Lossless Audio Engine</span>
        </div>
      </div>

      <div class="player-center-controls">
        <div class="player-btn-group">
          <button id="player-shuffle-btn" class="icon-btn" title="Toggle Shuffle" aria-label="Toggle Shuffle">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
          </button>

          <button id="player-prev-btn" class="icon-btn" title="Previous Track" aria-label="Previous Track">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="19 20 9 12 19 4 19 20"></polygon>
              <line x1="5" y1="19" x2="5" y2="5" stroke="currentColor" stroke-width="2"></line>
            </svg>
          </button>

          <button id="player-play-btn" class="play-btn-large" aria-label="Play or Pause">
            <svg id="player-play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <svg id="player-pause-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
              <rect x="6" y="4" width="4" height="16"></rect>
              <rect x="14" y="4" width="4" height="16"></rect>
            </svg>
          </button>

          <button id="player-next-btn" class="icon-btn" title="Next Track" aria-label="Next Track">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 4 15 12 5 20 5 4"></polygon>
              <line x1="19" y1="5" x2="19" y2="19" stroke="currentColor" stroke-width="2"></line>
            </svg>
          </button>

          <button id="player-loop-btn" class="icon-btn" title="Toggle Loop" aria-label="Toggle Loop">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
          </button>
        </div>

        <div class="scrub-timeline">
          <span id="player-current-time">0:00</span>
          <input 
            type="range" 
            id="player-scrub-input" 
            class="accessible-range" 
            min="0" 
            max="100" 
            value="0" 
            step="0.1" 
            aria-label="Seek audio position"
          />
          <span id="player-duration">0:00</span>
        </div>
      </div>

      <!-- Utilities: Playback rate & Volume -->
      <div class="player-utilities">
        <button id="rate-toggle-btn" class="icon-btn" style="width: auto; padding: 0 6px; font-size: 0.72rem; font-weight: 700;" title="Playback speed">1.0x</button>
        <div class="volume-control-box">
          <button id="mute-btn" class="icon-btn" aria-label="Mute or unmute">
            <svg id="volume-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
            <svg id="mute-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
          </button>
          <input 
            type="range" 
            id="volume-slider" 
            class="accessible-range" 
            min="0" 
            max="1" 
            step="0.05" 
            value="0.8" 
            aria-label="Audio volume"
          />
        </div>
      </div>
    </div>
  </aside>

  <!-- Single Audio Element -->
  <audio id="global-audio" preload="metadata"></audio>

  <!-- Embedded Static JSON for zero network overhead -->
  <script type="application/json" id="embedded-tracks-data" set:html={JSON.stringify(tracksData)} />

  <!-- Client-Side Progressive Engine -->
  <script is:inline>
    (() => {
      const allTracks = JSON.parse(document.getElementById('embedded-tracks-data').textContent || '[]');
      
      let filteredTracks = [...allTracks];
      let activeTag = 'ALL';
      let currentTrackId = null;
      let isShuffle = false;
      let isLoop = false;
      let lastFocusedElement = null;

      // DOM references
      const trackGrid = document.getElementById('track-grid');
      const emptyState = document.getElementById('empty-state');
      const resetFiltersBtn = document.getElementById('reset-filters-btn');
      const searchInput = document.getElementById('search-input');
      const audienceFilter = document.getElementById('audience-filter');
      const sortSelect = document.getElementById('sort-select');
      const tagsContainer = document.getElementById('tags-container');
      const countBadge = document.getElementById('count-badge');
      const toastContainer = document.getElementById('toast-container');

      // Modal DOM
      const modalOverlay = document.getElementById('detail-modal-overlay');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const modalArtworkImg = document.getElementById('modal-artwork-img');
      const modalTitle = document.getElementById('modal-title');
      const modalTrackTitle = document.getElementById('modal-track-title');
      const modalArtist = document.getElementById('modal-artist');
      const modalDescription = document.getElementById('modal-description');
      const modalPlayBtn = document.getElementById('modal-play-btn');
      const modalCopyIdBtn = document.getElementById('modal-copy-id-btn');
      const modalShareBtn = document.getElementById('modal-share-btn');

      const specId = document.getElementById('spec-id');
      const specRelease = document.getElementById('spec-release');
      const specAudience = document.getElementById('spec-audience');
      const specDuration = document.getElementById('spec-duration');
      const specSize = document.getElementById('spec-size');
      const specFormat = document.getElementById('spec-format');
      const specBitrate = document.getElementById('spec-bitrate');
      const specBpm = document.getElementById('spec-bpm');
      const specKey = document.getElementById('spec-key');

      // Player DOM
      const audio = document.getElementById('global-audio');
      const playerBar = document.getElementById('audio-player-bar');
      const playerImg = document.getElementById('player-img');
      const playerTitle = document.getElementById('player-title');
      const playerArtist = document.getElementById('player-artist');
      const playerFormat = document.getElementById('player-format');
      const playerPlayBtn = document.getElementById('player-play-btn');
      const playerPlayIcon = document.getElementById('player-play-icon');
      const playerPauseIcon = document.getElementById('player-pause-icon');
      const playerPrevBtn = document.getElementById('player-prev-btn');
      const playerNextBtn = document.getElementById('player-next-btn');
      const playerShuffleBtn = document.getElementById('player-shuffle-btn');
      const playerLoopBtn = document.getElementById('player-loop-btn');
      const scrubInput = document.getElementById('player-scrub-input');
      const playerCurrentTime = document.getElementById('player-current-time');
      const playerDuration = document.getElementById('player-duration');
      const volumeSlider = document.getElementById('volume-slider');
      const muteBtn = document.getElementById('mute-btn');
      const volumeIcon = document.getElementById('volume-icon');
      const muteIcon = document.getElementById('mute-icon');
      const rateToggleBtn = document.getElementById('rate-toggle-btn');

      let currentSelectedTrack = null;

      function showToast(message) {
        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.textContent = message;
        toastContainer.appendChild(toast);
        setTimeout(() => toast.remove(), 2600);
      }

      function formatSeconds(sec) {
        if (!sec || isNaN(sec)) return '0:00';
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return `${m}:${s < 10 ? '0' : ''}${s}`;
      }

      function parseDuration(str) {
        if (!str) return 0;
        const p = str.split(':').map(Number);
        return p.length === 2 ? p[0] * 60 + p[1] : p[0] || 0;
      }

      function escapeHtml(str) {
        return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function filterAndSortTracks() {
        const query = (searchInput.value || '').trim().toLowerCase();
        const aud = audienceFilter.value;
        const sort = sortSelect.value;

        filteredTracks = allTracks.filter(t => {
          const matchQuery = !query ||
            t.title.toLowerCase().includes(query) ||
            (t.description && t.description.toLowerCase().includes(query)) ||
            (t.format && t.format.toLowerCase().includes(query)) ||
            (t.key && t.key.toLowerCase().includes(query)) ||
            (t.bpm && t.bpm.toLowerCase().includes(query)) ||
            (t.tags && t.tags.some(tag => tag.toLowerCase().includes(query)));

          const matchAud = aud === 'ALL' || t.audience === aud;
          const matchTag = activeTag === 'ALL' || (t.tags && t.tags.includes(activeTag));

          return matchQuery && matchAud && matchTag;
        });

        filteredTracks.sort((a, b) => {
          if (sort === 'newest') return new Date(b.releaseDate) - new Date(a.releaseDate);
          if (sort === 'oldest') return new Date(a.releaseDate) - new Date(b.releaseDate);
          if (sort === 'title-asc') return a.title.localeCompare(b.title);
          if (sort === 'duration-desc') return parseDuration(b.duration) - parseDuration(a.duration);
          return 0;
        });

        renderGrid();
      }

      function renderGrid() {
        countBadge.textContent = `${filteredTracks.length} Track${filteredTracks.length === 1 ? '' : 's'}`;

        if (filteredTracks.length === 0) {
          trackGrid.style.display = 'none';
          emptyState.style.display = 'block';
          return;
        }

        emptyState.style.display = 'none';
        trackGrid.style.display = 'grid';

        trackGrid.innerHTML = filteredTracks.map((track, idx) => {
          const isCurrent = track.id === currentTrackId;
          const isPlaying = isCurrent && !audio.paused;

          return `
            <article class="track-card ${isPlaying ? 'is-active-playing' : ''}" data-id="${track.id}" data-index="${idx}" tabindex="0" role="region" aria-label="${escapeHtml(track.title)}">
              <div class="card-artwork-wrapper">
                <span class="card-id-code">#${track.id}</span>
                <span class="audience-pill audience-${track.audience}">${track.audience}</span>
                <img src="${track.artwork}" alt="${escapeHtml(track.title)} artwork" class="artwork-img" loading="lazy" />

                <button class="play-overlay-btn ${isPlaying ? 'is-playing' : ''}" data-action="toggle-play" data-id="${track.id}" aria-label="Play ${escapeHtml(track.title)}">
                  <div class="play-circle">
                    ${isPlaying ? `
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <rect x="6" y="4" width="4" height="16"></rect>
                        <rect x="14" y="4" width="4" height="16"></rect>
                      </svg>
                    ` : `
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                      </svg>
                    `}
                  </div>
                </button>
              </div>

              <div class="card-info-content">
                <h3 class="track-title">${escapeHtml(track.title)}</h3>
                <div class="track-artist">By ${escapeHtml(track.artist)}</div>
                <p class="track-description-preview">${escapeHtml(track.description || '')}</p>

                <div class="waveform-mini" aria-hidden="true">
                  <div class="wave-bar" style="--bar-h: 40%;"></div>
                  <div class="wave-bar" style="--bar-h: 70%;"></div>
                  <div class="wave-bar" style="--bar-h: 100%;"></div>
                  <div class="wave-bar" style="--bar-h: 50%;"></div>
                  <div class="wave-bar" style="--bar-h: 85%;"></div>
                  <div class="wave-bar" style="--bar-h: 30%;"></div>
                  <div class="wave-bar" style="--bar-h: 90%;"></div>
                  <div class="wave-bar" style="--bar-h: 60%;"></div>
                </div>

                <div class="spec-badges-row">
                  <span class="spec-badge">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    ${track.duration}
                  </span>
                  ${track.bpm ? `
                    <span class="spec-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                      ${track.bpm}
                    </span>
                  ` : ''}
                  ${track.format ? `
                    <span class="spec-badge">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 10v4M6 6v12M10 3v18M14 8v8M18 5v14M22 10v4"></path></svg>
                      ${track.format}
                    </span>
                  ` : ''}
                </div>
              </div>

              <div class="card-footer">
                <button class="detail-link-btn" data-action="open-detail" data-id="${track.id}">
                  <span>Inspect Technical Specs</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>
            </article>
          `;
        }).join('');
      }

      function loadAndPlayTrack(track) {
        if (!track) return;
        currentTrackId = track.id;

        playerImg.src = track.artwork;
        playerTitle.textContent = track.title;
        playerArtist.textContent = track.artist;
        playerFormat.textContent = `${track.format || 'Audio'} • ${track.bitrate || 'Lossless'}`;
        playerBar.classList.add('active');

        if (audio.src !== track.audioUrl) {
          audio.src = track.audioUrl;
        }

        audio.play().catch(e => console.warn('Audio play request aborted or blocked:', e));

        // Media Session API for native lock-screen / OS controls
        if ('mediaSession' in navigator) {
          navigator.mediaSession.metadata = new MediaMetadata({
            title: track.title,
            artist: track.artist,
            album: 'AudioDB Masters',
            artwork: [{ src: track.artwork, sizes: '512x512', type: 'image/svg+xml' }]
          });
        }

        renderGrid();
      }

      function togglePlayPause(trackId) {
        const track = allTracks.find(t => t.id === trackId);
        if (!track) return;

        if (currentTrackId === track.id) {
          if (audio.paused) {
            audio.play().catch(console.warn);
          } else {
            audio.pause();
          }
        } else {
          loadAndPlayTrack(track);
        }
      }

      function playNextTrack() {
        const pool = filteredTracks.length > 0 ? filteredTracks : allTracks;
        if (pool.length === 0) return;

        if (isShuffle) {
          const randomIdx = Math.floor(Math.random() * pool.length);
          loadAndPlayTrack(pool[randomIdx]);
          return;
        }

        const currentIdx = pool.findIndex(t => t.id === currentTrackId);
        const nextIdx = (currentIdx + 1) % pool.length;
        loadAndPlayTrack(pool[nextIdx]);
      }

      function playPrevTrack() {
        const pool = filteredTracks.length > 0 ? filteredTracks : allTracks;
        if (pool.length === 0) return;

        const currentIdx = pool.findIndex(t => t.id === currentTrackId);
        const prevIdx = (currentIdx - 1 + pool.length) % pool.length;
        loadAndPlayTrack(pool[prevIdx]);
      }

      function openModal(trackId) {
        const track = allTracks.find(t => t.id === trackId);
        if (!track) return;

        lastFocusedElement = document.activeElement;
        currentSelectedTrack = track;

        modalArtworkImg.src = track.artwork;
        modalTitle.textContent = track.title;
        modalTrackTitle.textContent = track.title;
        modalArtist.textContent = `By ${track.artist}`;
        modalDescription.textContent = track.description || 'No description available.';

        specId.textContent = `#${track.id}`;
        specRelease.textContent = new Date(track.releaseDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
        specAudience.textContent = track.audience;
        specDuration.textContent = track.duration;
        specSize.textContent = track.fileSize || 'N/A';
        specFormat.textContent = track.format || 'Standard Audio';
        specBitrate.textContent = track.bitrate || '24-bit / 96 kHz';
        specBpm.textContent = track.bpm || 'Unspecified';
        specKey.textContent = track.key || 'Unspecified';

        modalOverlay.classList.add('active');
        closeModalBtn.focus();
      }

      function closeModal() {
        modalOverlay.classList.remove('active');
        if (lastFocusedElement) lastFocusedElement.focus();
      }

      // Sync Native Audio Events to UI
      audio.addEventListener('play', () => {
        playerPlayIcon.style.display = 'none';
        playerPauseIcon.style.display = 'block';
        renderGrid();
      });

      audio.addEventListener('pause', () => {
        playerPlayIcon.style.display = 'block';
        playerPauseIcon.style.display = 'none';
        renderGrid();
      });

      audio.addEventListener('timeupdate', () => {
        if (!isNaN(audio.duration) && audio.duration > 0) {
          scrubInput.value = (audio.currentTime / audio.duration) * 100;
          playerCurrentTime.textContent = formatSeconds(audio.currentTime);
          playerDuration.textContent = formatSeconds(audio.duration);
        }
      });

      audio.addEventListener('ended', () => {
        if (isLoop) {
          audio.currentTime = 0;
          audio.play().catch(console.warn);
        } else {
          playNextTrack();
        }
      });

      // Scrubbing input control
      scrubInput.addEventListener('input', () => {
        if (!isNaN(audio.duration) && audio.duration > 0) {
          audio.currentTime = (scrubInput.value / 100) * audio.duration;
        }
      });

      // Volume & Mute control
      volumeSlider.addEventListener('input', () => {
        audio.volume = parseFloat(volumeSlider.value);
        audio.muted = audio.volume === 0;
        volumeIcon.style.display = audio.muted ? 'none' : 'block';
        muteIcon.style.display = audio.muted ? 'block' : 'none';
      });

      muteBtn.addEventListener('click', () => {
        audio.muted = !audio.muted;
        volumeIcon.style.display = audio.muted ? 'none' : 'block';
        muteIcon.style.display = audio.muted ? 'block' : 'none';
        volumeSlider.value = audio.muted ? 0 : audio.volume;
      });

      // Rate Toggle (1.0x, 1.25x, 1.5x)
      const rates = [1.0, 1.25, 1.5];
      let rateIdx = 0;
      rateToggleBtn.addEventListener('click', () => {
        rateIdx = (rateIdx + 1) % rates.length;
        audio.playbackRate = rates[rateIdx];
        rateToggleBtn.textContent = `${rates[rateIdx].toFixed(1)}x`;
      });

      // Controls
      playerPlayBtn.addEventListener('click', () => {
        if (currentTrackId) {
          togglePlayPause(currentTrackId);
        } else if (filteredTracks.length > 0) {
          loadAndPlayTrack(filteredTracks[0]);
        }
      });

      playerNextBtn.addEventListener('click', playNextTrack);
      playerPrevBtn.addEventListener('click', playPrevTrack);

      playerShuffleBtn.addEventListener('click', () => {
        isShuffle = !isShuffle;
        playerShuffleBtn.classList.toggle('active', isShuffle);
        showToast(isShuffle ? 'Shuffle mode enabled' : 'Shuffle mode disabled');
      });

      playerLoopBtn.addEventListener('click', () => {
        isLoop = !isLoop;
        playerLoopBtn.classList.toggle('active', isLoop);
        showToast(isLoop ? 'Repeat track enabled' : 'Repeat track disabled');
      });

      // Media Session Handlers
      if ('mediaSession' in navigator) {
        navigator.mediaSession.setActionHandler('play', () => audio.play());
        navigator.mediaSession.setActionHandler('pause', () => audio.pause());
        navigator.mediaSession.setActionHandler('previoustrack', playPrevTrack);
        navigator.mediaSession.setActionHandler('nexttrack', playNextTrack);
      }

      // Search & Filters Listeners
      searchInput.addEventListener('input', filterAndSortTracks);
      audienceFilter.addEventListener('change', filterAndSortTracks);
      sortSelect.addEventListener('change', filterAndSortTracks);

      resetFiltersBtn.addEventListener('click', () => {
        searchInput.value = '';
        audienceFilter.value = 'ALL';
        sortSelect.value = 'newest';
        activeTag = 'ALL';
        document.querySelectorAll('.tag-btn').forEach(b => b.classList.toggle('active', b.dataset.tag === 'ALL'));
        filterAndSortTracks();
      });

      tagsContainer.addEventListener('click', (e) => {
        const btn = e.target.closest('.tag-btn');
        if (btn) {
          document.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeTag = btn.dataset.tag;
          filterAndSortTracks();
        }
      });

      // Keyboard shortcuts
      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !modalOverlay.classList.contains('active')) {
          e.preventDefault();
          searchInput.focus();
        }
        if (e.key === 'Escape' && modalOverlay.classList.contains('active')) {
          closeModal();
        }
        if (e.code === 'Space' && document.activeElement.tagName !== 'INPUT' && !modalOverlay.classList.contains('active')) {
          e.preventDefault();
          if (currentTrackId) togglePlayPause(currentTrackId);
          else if (filteredTracks.length > 0) loadAndPlayTrack(filteredTracks[0]);
        }
      });

      // Track Card Click Delegation
      trackGrid.addEventListener('click', (e) => {
        const playBtn = e.target.closest('[data-action="toggle-play"]');
        if (playBtn) {
          e.stopPropagation();
          togglePlayPause(playBtn.dataset.id);
          return;
        }

        const card = e.target.closest('.track-card');
        if (card) {
          openModal(card.dataset.id);
        }
      });

      // Modal Buttons
      closeModalBtn.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', (e) => {
        if (e.target === modalOverlay) closeModal();
      });

      modalPlayBtn.addEventListener('click', () => {
        if (currentSelectedTrack) {
          loadAndPlayTrack(currentSelectedTrack);
        }
      });

      modalCopyIdBtn.addEventListener('click', () => {
        if (currentSelectedTrack) {
          navigator.clipboard.writeText(currentSelectedTrack.id);
          showToast(`Copied Track ID #${currentSelectedTrack.id}`);
        }
      });

      modalShareBtn.addEventListener('click', () => {
        if (currentSelectedTrack) {
          navigator.clipboard.writeText(currentSelectedTrack.audioUrl);
          showToast('Copied Audio URL to clipboard');
        }
      });
    })();
  </script>
</body>
</html>