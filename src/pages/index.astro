---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import tracksData from '../../public/data/tracks.json';
import artistData from '../../public/data/artist.json';
import { slugify } from '../utils/audio';

const recentTracks = [...tracksData].slice(0, 6);
const allTags = Array.from(new Set(tracksData.flatMap(t => t.tags || [])));
---

<BaseLayout title="Home — Studio Audio Hub">
  <main class="container" style="padding-top: 2rem;">
    <!-- Welcome Hero -->
    <section style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 3rem 2rem; margin-bottom: 2.5rem; text-align: center;">
      <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem;">Studio Master Audio Directory</h1>
      <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto 1.75rem auto;">
        Browse master-quality audio stems, experimental synth recordings, artist profiles, and genre tags.
      </p>
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/files" class="btn btn-primary">Browse All Files ({tracksData.length})</a>
        <a href={`/artist/${artistData.name}`} class="btn btn-secondary">Featured Artist: {artistData.name}</a>
        <a href="/tags" class="btn btn-secondary">Explore Tags</a>
      </div>
    </section>

    <!-- Recent Files Section -->
    <section style="margin-bottom: 3rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.5rem;">Latest Master Recordings</h2>
        <a href="/files" style="color: var(--primary); text-decoration: none; font-weight: 600;">View All Files →</a>
      </div>

      <div class="track-grid">
        {recentTracks.map(track => {
          const trackSlug = slugify(track.title);
          return (
            <article class="track-card">
              <div class="artwork-box">
                <img src={track.artwork} alt={track.title} class="artwork-img" loading="lazy" />
                <button 
                  class="play-btn-overlay" 
                  data-play-url={track.audioUrl} 
                  data-play-title={track.title} 
                  data-play-artist={track.artist}
                  data-play-artwork={track.artwork}
                  aria-label={`Play ${track.title}`}
                >
                  <div class="play-circle">▶</div>
                </button>
              </div>

              <div style="display: flex; flex-direction: column; gap: 4px;">
                <h3 style="font-size: 1rem; font-weight: 700;">
                  <a href={`/file/${trackSlug}`} style="color: inherit; text-decoration: none;">{track.title}</a>
                </h3>
                <a href={`/artist/${track.artist}`} style="font-size: 0.8rem; color: var(--accent-purple); text-decoration: none;">
                  By {track.artist}
                </a>
              </div>

              <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-dim);">
                <span>{track.duration}</span>
                <a href={`/file/${trackSlug}`} class="btn btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">Details</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>