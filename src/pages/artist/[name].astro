---
// src/pages/artist/[name].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import artistData from '../../../public/data/artist.json';
import tracksData from '../../../public/data/tracks.json';
import { normalizeArtists, slugify } from '../../utils/audio';

export async function getStaticPaths() {
  const artists = normalizeArtists(artistData);
  return artists.map(artist => ({
    params: { name: artist.slug },
    props: { artist }
  }));
}

const { artist } = Astro.props;
const artistTracks = tracksData.filter(t => t.artist === artist.name);
---

<BaseLayout title={`${artist.name} — Artist Profile & Files`}>
  <main class="container" style="padding-top: 1.5rem;">
    <!-- Banner -->
    <div style="position: relative; border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-surface); border: 1px solid var(--border-color); margin-bottom: 2.5rem;">
      <div style="height: 200px;">
        <img src={artist.banner} alt={artist.name} style="width: 100%; height: 100%; object-fit: cover; opacity: 0.7;" />
      </div>
      <div style="padding: 0 2rem 2rem 2rem; display: flex; flex-direction: column; gap: 1rem; margin-top: -60px; position: relative;">
        <img src={artist.avatar} alt={artist.name} style="width: 120px; height: 120px; border-radius: 50%; border: 4px solid var(--bg-surface); object-fit: cover;" />
        <div>
          <h1 style="font-size: 2.2rem; font-weight: 800;">{artist.name}</h1>
          <div style="color: var(--accent-purple); font-weight: 600;">{artist.genre}</div>
          <p style="color: var(--text-muted); max-width: 800px; margin-top: 0.5rem;">{artist.bio}</p>
        </div>
      </div>
    </div>

    <!-- Artist Tracks List -->
    <section>
      <h2 style="font-size: 1.5rem; margin-bottom: 1.25rem;">Master Audio Catalog ({artistTracks.length})</h2>
      <div class="track-grid">
        {artistTracks.map(track => {
          const trackSlug = slugify(track.title);
          return (
            <article class="track-card">
              <div class="artwork-box">
                <img src={track.artwork} alt={track.title} class="artwork-img" loading="lazy" />
                <button 
                  class="play-btn-overlay" 
                  data-play-url={track.audioUrl} 
                  data-play-title={track.title} 
                  data-play-artist={track.artist}
                  data-play-artwork={track.artwork}
                >
                  <div class="play-circle">▶</div>
                </button>
              </div>

              <div>
                <h3 style="font-size: 1rem; font-weight: 700;">
                  <a href={`/file/${trackSlug}`} style="color: inherit; text-decoration: none;">{track.title}</a>
                </h3>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">{track.duration} • {track.format || 'Lossless'}</div>
              </div>

              <div style="margin-top: auto; padding-top: 8px; border-top: 1px solid var(--border-color);">
                <a href={`/file/${trackSlug}`} class="btn btn-secondary" style="width: 100%; justify-content: center; font-size: 0.78rem;">Inspect File Specs →</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>