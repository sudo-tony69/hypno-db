---
// src/pages/files.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import tracksData from '../../public/data/tracks.json';
import { slugify } from '../utils/audio';

const allTags = Array.from(new Set(tracksData.flatMap(t => t.tags || []))).sort();
---

<BaseLayout title="All Master Files">
  <main class="container" style="padding: 2rem 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 2.2rem; font-weight: 800;">Master Audio Repository</h1>
        <p style="color: var(--text-muted);">Complete catalog of all stems and release files ({tracksData.length} records)</p>
      </div>

      <input 
        type="search" 
        id="file-filter-input" 
        placeholder="Search files, formats, keys..." 
        style="padding: 0.75rem 1rem; border-radius: var(--radius-md); background: var(--bg-surface); border: 1px solid var(--border-color); color: #fff; width: 300px;"
      />
    </div>

    <!-- Tags Row -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
      <a href="/files" class="btn btn-primary" style="padding: 0.3rem 0.8rem; font-size: 0.8rem;">All</a>
      {allTags.map(tag => (
        <a href={`/tag/${tag}`} class="btn btn-secondary" style="padding: 0.3rem 0.8rem; font-size: 0.8rem;">{tag}</a>
      ))}
    </div>

    <div class="track-grid" id="files-grid">
      {tracksData.map(track => {
        const trackSlug = slugify(track.title);
        return (
          <article class="track-card" data-title={track.title.toLowerCase()} data-tags={(track.tags || []).join(' ').toLowerCase()}>
            <div class="artwork-box">
              <img src={track.artwork} alt={track.title} class="artwork-img" loading="lazy" />
              <button 
                class="play-btn-overlay" 
                data-play-url={track.audioUrl} 
                data-play-title={track.title} 
                data-play-artist={track.artist}
                data-play-artwork={track.artwork}
              >
                <div class="play-circle">▶</div>
              </button>
            </div>

            <div>
              <h2 style="font-size: 1rem; font-weight: 700;">
                <a href={`/file/${trackSlug}`} style="color: inherit; text-decoration: none;">{track.title}</a>
              </h2>
              <a href={`/artist/${track.artist}`} style="font-size: 0.8rem; color: var(--accent-purple); text-decoration: none;">By {track.artist}</a>
            </div>

            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px;">
              {track.tags?.map(tg => (
                <a href={`/tag/${tg}`} style="font-size: 0.68rem; background: rgba(255,255,255,0.06); padding: 2px 6px; border-radius: 4px; color: var(--accent-cyan); text-decoration: none;">{tg}</a>
              ))}
            </div>

            <div style="margin-top: auto; padding-top: 8px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.75rem; color: var(--text-dim); font-family: monospace;">{track.duration}</span>
              <a href={`/file/${trackSlug}`} class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">Full View →</a>
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <script is:inline>
    const filterInput = document.getElementById('file-filter-input');
    const cards = document.querySelectorAll('#files-grid .track-card');
    filterInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      cards.forEach(card => {
        const title = card.dataset.title || '';
        const tags = card.dataset.tags || '';
        card.style.display = (title.includes(q) || tags.includes(q)) ? 'flex' : 'none';
      });
    });
  </script>
</BaseLayout>