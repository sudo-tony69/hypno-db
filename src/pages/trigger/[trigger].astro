---
// src/pages/tag/[tag].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import artistData from '../../../public/data/artist.json';
import tracksData from '../../../public/data/tracks.json';
import triggerData from '../../../public/data/triggers.json';
import { normalizeArtists, resolveArtistSlug, slugify } from '../../utils/audio';

const artists = normalizeArtists(artistData);

export async function getStaticPaths() {
  const allTriggers = triggerData.map(trigger => ({
    slug: trigger.slug || slugify(trigger.name),
    name: trigger.name
  }));

  return allTriggers.map(({ slug, name }) => ({
    params: { trigger: slug },
    props: {
      trigger: slug,
      triggerName: name,
      tracks: tracksData.filter(track => (track.triggers || []).includes(name))
    }
  }));
}

const { trigger, triggerName, tracks } = Astro.props;
---

<BaseLayout title={`#${triggerName} Master Audio Files`}>
  <main class="container" style="padding: 2.5rem 1.5rem;">
    <!-- Header -->
    <div style="margin-bottom: 2rem;">
      <nav style="font-size: 0.85rem; color: var(--text-dim); margin-bottom: 0.75rem;">
        <a href="/triggers" style="color: var(--text-muted); text-decoration: none;">← All Triggers</a>
      </nav>
      <h1 style="font-size: 2.2rem; font-weight: 800;">Trigger: <span style="color: var(--accent-cyan);">#{triggerName}</span></h1>
      <p style="color: var(--text-muted);">{tracks.length} master track{tracks.length > 1 ? 's' : ''} tagged with #{triggerName}</p>
    </div>

    <!-- Grid -->
    <div class="track-grid">
      {tracks.map(track => {
        const trackSlug = slugify(track.title);
        return (
          <article class="track-card">
            <div class="artwork-box">
              <img src={track.artwork} alt={track.title} class="artwork-img" loading="lazy" />
              <button 
                class="play-btn-overlay" 
                data-play-url={track.audioUrl} 
                data-play-title={track.title} 
                data-play-artist={track.artist}
                data-play-artwork={track.artwork}
              >
                <div class="play-circle">▶</div>
              </button>
            </div>

            <div>
              <h2 style="font-size: 1rem; font-weight: 700;">
                <a href={`/file/${trackSlug}`} style="color: inherit; text-decoration: none;">{track.title}</a>
              </h2>
              <a href={`/artist/${resolveArtistSlug(track.artist, artists)}`} style="font-size: 0.8rem; color: var(--accent-purple); text-decoration: none;">By {track.artist}</a>
            </div>

            <div style="margin-top: auto; padding-top: 8px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.75rem; color: var(--text-dim);">{track.duration}</span>
              <a href={`/file/${trackSlug}`} class="btn btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">View File Details →</a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>